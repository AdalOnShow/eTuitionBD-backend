generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum TuitionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GradeLevel {
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  name            String
  username        String  @unique
  password        String? // Nullable — Google-only users may not have a password
  role            Role    @default(STUDENT)
  isActive        Boolean @default(true)
  isEmailVerified Boolean @default(false) // Set true after code verification or Google login
  profileComplete Boolean @default(false)
  avatarUrl       String? // Cloudinary image URL
  googleId        String? @unique // Google OAuth user ID — null for email/password users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  tutorProfile   TutorProfile?

  applications Application[]
  tuitions     Tuition[]     @relation("StudentTuitions")
  payments     Payment[]
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phone      String
  address    String
  gradeLevel GradeLevel
  school     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TutorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  bio            String?
  subjects       String[]
  experience     String
  education      String
  hourlyRate     Int      // In BDT
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tuition {
  id          String     @id @default(cuid())
  title       String
  description String
  subject     String
  gradeLevel  GradeLevel // Grade the tuition is for — separate from student's own grade
  budget      Int        // In BDT
  location    String

  studentId String
  student   User   @relation("StudentTuitions", fields: [studentId], references: [id])

  status TuitionStatus @default(OPEN)

  applications Application[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(cuid())

  tutorId String
  tutor   User   @relation(fields: [tutorId], references: [id])

  tuitionId String
  tuition   Tuition @relation(fields: [tuitionId], references: [id])

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tuitionId String
  tuition   Tuition @relation(fields: [tuitionId], references: [id])

  amount  Int           // In BDT
  status  PaymentStatus @default(PENDING)
  tranId  String?       // SSLCommerz tran_id
  valId   String?       // SSLCommerz val_id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
