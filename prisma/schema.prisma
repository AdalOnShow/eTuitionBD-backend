generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  username String   @unique
  password String
  role     String   @default("student")
  profile  Profile?
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  bio       String?
  avatarUrl String?
  user      User    @relation(fields: [userId], references: [id])
}
